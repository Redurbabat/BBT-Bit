    "What should we call you?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie sollen wir dich nennen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo quieres que te llamemos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment devons-nous vous appeler ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איך לקרוא לך?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपको क्या कहकर बुलाएँ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda ingin dipanggil apa?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come vuoi che ti chiamiamo?"
          }
        },
