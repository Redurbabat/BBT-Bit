    "May match the wrong version of a song. Enable at your own risk.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann die falsche Version eines Songs erwischen. Aktivieren auf eigene Gefahr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede elegir la versión equivocada de una canción. Actívalo bajo tu propio riesgo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut trouver la mauvaise version d'un titre. Active-le à tes risques et périls."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עלול להתאים גרסה שגויה של שיר. ההפעלה על אחריותכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गाने का गलत वर्शन मिल सकता है। अपने जोखिम पर चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisa mencocokkan versi lagu yang salah. Aktifkan dengan risiko sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe trovare la versione sbagliata di un brano. Attivalo a tuo rischio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲の別バージョンに一致してしまうことがあります。自己責任で有効にしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może dopasować złą wersję utworu. Włączasz na własne ryzyko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode encontrar a versão errada de uma música. Ative por sua conta e risco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может подобрать не ту версию песни. Включайте на свой страх и риск."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาจจับคู่กับเพลงผิดเวอร์ชัน เปิดใช้โดยยอมรับความเสี่ยงเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şarkının yanlış sürümünü eşleştirebilir. Riski sana ait olmak üzere etkinleştir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể khớp nhầm phiên bản bài hát. Hãy tự chịu rủi ro khi bật."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可能匹配到歌曲的錯誤版本。啟用風險自負。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
