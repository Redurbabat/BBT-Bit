          "stringUnit": {
            "state": "translated",
            "value": "どうお呼びしましょうか?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak mamy się do ciebie zwracać?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como devemos chamar você?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как к вам обращаться?"
          }
        },
        "th": {
