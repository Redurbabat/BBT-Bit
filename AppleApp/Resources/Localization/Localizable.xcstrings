    "No enabled source can provide lossless audio. Add an addon to play lossless files without transcoding.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine aktivierte Quelle kann verlustfreies Audio liefern. Füge ein eigenes Modul hinzu, um verfügbare verlustfreie Dateien ohne Transkodierung abzuspielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna fuente activa ofrece audio sin pérdida. Agrega un módulo personalizado para reproducir archivos sin pérdida disponibles sin transcodificarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune source activée ne peut fournir de l'audio sans perte. Ajoutez un module personnalisé pour lire les fichiers sans perte disponibles sans transcodage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום מקור מופעל אינו יכול לספק שמע ללא אובדן נתונים. הוסף מודול מותאם אישית כדי להפעיל קבצים זמינים ללא אובדן נתונים ללא המרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी चालू स्रोत लॉसलेस ऑडियो नहीं दे सकता। बिना ट्रांसकोडिंग के उपलब्ध लॉसलेस फ़ाइलें चलाने के लिए कस्टम मॉड्यूल जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada sumber aktif yang dapat menyediakan audio lossless. Tambahkan modul kustom untuk memutar file lossless yang tersedia tanpa transcoding."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna sorgente attiva può fornire audio lossless. Aggiungi un modulo personalizzato per riprodurre i file lossless disponibili senza transcodifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なソースの中にロスレスオーディオを提供できるものがありません。トランスコードなしでロスレスファイルを再生するにはカスタムモジュールを追加してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne włączone źródło nie może dostarczyć bezstratnego dźwięku. Dodaj moduł niestandardowy, aby odtwarzać dostępne pliki bezstratne bez transkodowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma fonte habilitada pode fornecer áudio lossless. Adicione um módulo personalizado para tocar arquivos lossless sem transcodificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один включённый источник не может предоставить аудио без потерь. Добавьте пользовательский модуль, чтобы воспроизводить доступные файлы без потерь без перекодирования."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีแหล่งข้อมูลที่เปิดใช้งานสามารถให้เสียงแบบไม่สูญเสียคุณภาพได้ เพิ่มแอดออนเพื่อเล่นไฟล์ไม่สูญเสียคุณภาพโดยไม่ต้องแปลงไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin hiçbir kaynak kayıpsız ses sağlayamıyor. Yeniden kodlama yapmadan mevcut kayıpsız dosyaları çalmak için özel bir modül ekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có nguồn nào được bật có thể cung cấp âm thanh Lossless. Hãy thêm tiện ích mở rộng để phát các tệp Lossless mà không cần chuyển mã."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已啟用的來源均無法提供無損音訊。新增自定義模組即可播放可用的無損檔案，而無需轉碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用的来源均无法提供无损音频。添加自定义模块即可播放可用的无损文件，而无需转码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已啟用的來源均無法提供無損音訊。新增自定義模組即可播放可用的無損檔案，而無需轉碼。"
          }
        }
      }
    },
