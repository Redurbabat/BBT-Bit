        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activé, fermer l'application depuis les applications récentes arrête aussi la musique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשמופעל, סגירת האפליקציה ממסך האפליקציות האחרונות תעצור גם את השמעת המוזיקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू होने पर, हाल के ऐप्स स्क्रीन से ऐप बंद करने पर संगीत प्लेबैक भी रुक जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika diaktifkan, menutup aplikasi dari layar aplikasi terbaru juga akan menghentikan pemutaran musik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando attivo, chiudere l'app dalla schermata delle app recenti interrompe anche la riproduzione musicale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、最近のアプリ画面からアプリを終了した際に音楽の再生も停止します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po włączeniu, zamknięcie aplikacji z listy ostatnio używanych aplikacji zatrzyma odtwarzanie muzyki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, fechar o app pela tela de apps recentes também interrompe a reprodução de música."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При включении закрытие приложения из недавних также останавливает воспроизведение музыки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirildiğinde, uygulamayı son kullanılanlar ekranından kapatmak müzik çalmayı da durdurur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật, việc đóng ứng dụng khỏi màn hình ứng dụng gần đây cũng sẽ dừng phát nhạc."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，從最近任務介面關閉應用也會停止音樂播放。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，从最近任务界面关闭应用也会停止音乐播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，從最近任務介面關閉應用也會停止音樂播放。"
          }
        }
      }
    },
